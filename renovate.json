{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "automerge": false,
  "enabledManagers": [
    "helmv3"
  ],

  "ignorePaths": [
    "**/values*.yaml"
  ],
  "registryAliases": {
    "rancher-proxy": "https://nexus.xalab.io/repository/rancher-helm/",
    "argo-proxy": "https://nexus.xalab.io/repository/argo-helm/",
    "cert-manager-proxy": "https://nexus.xalab.io/repository/cert-manager-helm/",
    "cilium-proxy": "https://nexus.xalab.io/repository/cilium-helm/",
    "external-dns-proxy": "https://nexus.xalab.io/repository/external-dns-helm/",
    "external-secrets-proxy": "https://nexus.xalab.io/repository/external-secrets-helm/",
    "longhorn-proxy": "https://nexus.xalab.io/repository/longhorn-helm/",
    "metallb-proxy": "https://nexus.xalab.io/repository/metallb-helm/",
    "traefik-proxy": "https://nexus.xalab.io/repository/traefik-helm/",
    "victoria-metrics-proxy":"https://nexus.xalab.io/repository/vm-helm/",
    "metrics-server-proxy": "https://nexus.xalab.io/repository/metrics-server-helm/",
    "app-template-proxy":"https://nexus.xalab.io/repository/app-template/"
  },
  "extends": [
    "config:recommended"
  ],
  "prBodyTemplate": "{{{table}}}{{{changelogs}}}",
  "timezone": "America/New_York",
  "packageRules": [
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "major", "minor", "patch"
      ],
      "labels": [
        "patch-updates"
      ],
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "from {{currentVersion}} to {{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}"
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": true
    },
    {
      "description": "Automerge only Renovate's own Helm chart updates",
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "renovate"
      ],
      "matchFileNames": [
        "kubernetes-deployments/applications/renovate/Chart.yaml"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]

}
